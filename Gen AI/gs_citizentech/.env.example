# Copie para .env e ajuste. NUNCA versione o .env com chaves reais.
# LLM_PROVIDER: auto | ollama | openai | extractive
#  ollama     -> LLM local GRATUITO (recomendado sem créditos): instale o Ollama e rode `ollama pull qwen2.5:3b`
#  auto       -> OpenAI se OPENAI_API_KEY existir; senão Ollama, se estiver rodando; senão extractive (offline)
#  extractive -> sem LLM (cada frase vem literalmente da base)
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:3b
# Só se for usar OpenAI (pago):
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# EMBEDDING_BACKEND: sentence-transformers | hashing (fallback leve, sem download)
EMBEDDING_BACKEND=sentence-transformers
