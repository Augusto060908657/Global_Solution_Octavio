# Copie para .env (NUNCA versione o .env). Este projeto usa Ollama local: não há chave de API paga.

# ---- Ollama / LLM (back-end) ----
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b          # troque por qwen2.5:7b, qwen2.5:1.5b etc. conforme sua máquina
LLM_TIMEOUT_SECONDS=90

# ---- Back-end ----
ENVIRONMENT=development          # em produção use "production" (proíbe CORS com *)
ALLOWED_ORIGINS=http://localhost:8501   # lista separada por vírgula; nunca "*" em produção
DATA_DIR=./data
LOG_LEVEL=INFO

# ---- Front-end ----
API_BASE_URL=http://localhost:8000
API_TIMEOUT_SECONDS=120
